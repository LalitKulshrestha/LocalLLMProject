LOCALFORGE_HOST=127.0.0.1
LOCALFORGE_PORT=8787
LOCALFORGE_DATA_DIR=./data
LOCALFORGE_OUTPUT_DIR=./data/outputs
LOCALFORGE_WORKFLOW_DIR=./workflows

COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_DIR=./engines/ComfyUI
COMFYUI_PYTHON=./engines/ComfyUI/.venv/bin/python
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors

FACEFUSION_DIR=./engines/facefusion
FACEFUSION_PYTHON=./engines/facefusion/.venv/bin/python
FACEFUSION_EXECUTION_PROVIDERS=coreml,cpu
FACEFUSION_EXECUTION_THREAD_COUNT=2
FACEFUSION_WORKFLOW_STRATEGY=disk
FACEFUSION_VIDEO_MEMORY_STRATEGY=strict
FACEFUSION_FACE_SWAPPER_MODEL=alphaface_256
FACEFUSION_OUTPUT_VIDEO_ENCODER=h264_videotoolbox

# The app rejects non-loopback binding unless this is explicitly enabled.
LOCALFORGE_ALLOW_REMOTE=false
